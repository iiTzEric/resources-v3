// ============================================
// PRISMA SCHEMA
//
// WHAT: Source of truth for the Postgres database
//       structure — tables, columns, relationships
// WHEN: Any project using Postgres + Prisma instead
//       of MongoDB + Mongoose
// WHY:  Changes here are applied to the real database
//       via migrations, so app code and the database
//       structure can never silently drift apart
//
// USAGE:
// 1. Edit this file to add/change models
// 2. npx prisma migrate dev --name <what_changed>
// 3. The Prisma Client (utils/prisma.js) is
//    auto-regenerated with the new types
// ============================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  completed   Boolean  @default(false)
  priority    Priority @default(MEDIUM)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
