{
  "name": "resource-guide-backend",
  "private": true,
  "scripts": {
    "start:mongo": "node mongodb/server.js",
    "start:postgres": "node postgres/server.js",
    "check": "find . -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test tests/*.test.js",
    "prisma:validate": "prisma validate --schema postgres/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema postgres/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}
